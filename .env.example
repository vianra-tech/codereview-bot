# =============================================================================
# CodeReview.ai - Minimal Environment Variables (12 Critical Secrets)
# Copy to .env and fill in ONLY these 12 values.
# Everything else has hardened defaults in docker-compose.yml
# =============================================================================

# -----------------------------------------------------------------------------
# 1. GITHUB APP (Required for webhook ingestion & PR comments)
# -----------------------------------------------------------------------------
GITHUB_APP_ID=YOUR_GITHUB_APP_ID
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END RSA PRIVATE KEY-----"
GITHUB_WEBHOOK_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_BASE64_32
GITHUB_CLIENT_ID=YOUR_GITHUB_CLIENT_ID
GITHUB_CLIENT_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_BASE64_32

# -----------------------------------------------------------------------------
# 2. SUPABASE (PostgreSQL - Primary Database)
# -----------------------------------------------------------------------------
SUPABASE_URL=https://YOUR_PROJECT_SUPABASE_PROJECT_REF.supabase.co
SUPABASE_DB_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_SUPABASE_PROJECT_REF.supabase.co:5432/postgres?sslmode=require
SUPABASE_KEY=YOUR_SUPABASE_ANON_OR_SERVICE_ROLE_KEY
SUPABASE_JWT_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_BASE64_32

# -----------------------------------------------------------------------------
# 3. NVIDIA NIM (LLM Inference for Semantic Analysis)
# -----------------------------------------------------------------------------
NVIDIA_NIM_API_KEY=nvapi-YOUR_KEY_HERE

# -----------------------------------------------------------------------------
# 4. INFRASTRUCTURE PASSWORDS (Generate with: openssl rand -base64 16)
# -----------------------------------------------------------------------------
CLICKHOUSE_PASSWORD=CHANGE_ME_GENERATE_STRONG_PASSWORD
MINIO_ROOT_PASSWORD=CHANGE_ME_GENERATE_STRONG_PASSWORD

# -----------------------------------------------------------------------------
# 5. AUTH & DOMAIN
# -----------------------------------------------------------------------------
NEXTAUTH_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_BASE64_32
DOMAIN=yourdomain.com

# =============================================================================
# THAT'S IT — Only 12 variables to set.
# All other configs (usernames, DB names, ports, internal URLs) are hardcoded
# with secure defaults in docker-compose.yml
# =============================================================================